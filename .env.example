# Passcode that unlocks /admin for a signed-in user. Defaults to "chicano".
ADMIN_PASSCODE=chicano

# SMS delivery. Leave unset to keep the simulated driver: messages are queued
# and recorded in the outbox, but nothing is actually sent.
# SMS_PROVIDER=smsru
# SMS_API_KEY=your-sms-ru-api-key
# SMS_FROM=CHICANO
